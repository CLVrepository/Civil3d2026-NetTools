<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(GisTestTargetFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(GisTestTargetFramework)' != ''">$(GisTestTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../CLV_CivilTools/Gis/GisNewDrawingNativeOutputs.cs" Link="GisNewDrawingNativeOutputs.cs" />
  </ItemGroup>
</Project>
