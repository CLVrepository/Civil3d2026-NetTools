<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(GisTestTargetFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(GisTestTargetFramework)' != ''">$(GisTestTargetFramework)</TargetFramework>
    <AssemblyName>OSGeo.FDO</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FakeFdo.cs" />
    <Compile Include="../../CLV_CivilTools/Gis/GisNewDrawingProfile.cs" Link="GisNewDrawingProfile.cs" />
    <Compile Include="../../CLV_CivilTools/Gis/GisNewDrawingSdf.cs" Link="GisNewDrawingSdf.cs" />
    <None Include="../GisNewDrawingProfile.Tests/Fixtures/*.ipf" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
